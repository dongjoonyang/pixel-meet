# 실시간 서버(socket.io) 주소. 배포한 공개 URL을 쓰면 어디서든 붙는다.
# 같은 Wi-Fi에서 로컬로만 테스트할 땐 PC의 LAN IP(http://192.168.x.x:4000)로 바꿔도 된다.
EXPO_PUBLIC_SERVER_URL=https://your-server.onrender.com

# Supabase 프로젝트 설정 → API 에서 확인 (anon/public key만 쓴다 — service_role 키는 절대 클라이언트에 넣지 않는다)
EXPO_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...
